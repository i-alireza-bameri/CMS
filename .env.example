# ==========================================
# OmniSpace Environment Configuration
# ==========================================

# Port for Full-Stack Server
PORT=3000

# Backend SQLite Database URL (Default)
DATABASE_URL="sqlite:///./omnispace.db"

# Or PostgreSQL Database URL (Swap for Postgres)
# DATABASE_URL="postgresql+psycopg2://omnispace:omnispace_secret@localhost:5432/omnispace_db"

# JWT Secret Key for token signing and validation
JWT_SECRET="omnispace-enterprise-super-secret-key-2026"

# Directory for file uploads
UPLOAD_DIR="./uploads"

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional Gemini API Key (if AI features are enabled)
GEMINI_API_KEY=""
